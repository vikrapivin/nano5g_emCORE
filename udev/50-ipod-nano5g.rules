# iPod nano 5G (S5L8730) USB modes: install so every device op works without root
# (without it, libusb_open fails with Errno 13 Access denied).
#   05ac:1231  bootROM DFU (Menu+Select, then the ROM's recovery mode; images are sent with wInd3x)
#   05ac:1225  nano 4G bootROM DFU (kept for mixed benches)
#   ffff:e000  emCORE (the DFU-booted kernel of this bundle)
SUBSYSTEM=="usb", ATTR{idVendor}=="05ac", ATTR{idProduct}=="1231", MODE="0666"
SUBSYSTEM=="usb", ATTR{idVendor}=="05ac", ATTR{idProduct}=="1225", MODE="0666"
SUBSYSTEM=="usb", ATTR{idVendor}=="ffff", ATTR{idProduct}=="e000", MODE="0666"
